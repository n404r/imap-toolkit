# Admin panel password (required - change before deploying)
ADMIN_PASSWORD=change_me_before_deploy

# JWT secret for session tokens (required - generate a random 64-char hex string)
JWT_SECRET=change_me_to_a_random_64_char_hex_string

# AES-256-GCM key for encrypting IMAP passwords (required - 64 hex chars = 32 bytes)
ENCRYPTION_KEY=change_me_to_a_random_64_char_hex_string

# Server port (default: 3000)
PORT=3000

# SQLite database file path (default: ./data/imap-toolkit.db)
DB_PATH=./data/imap-toolkit.db

# Log level: fatal | error | warn | info | debug | trace (default: info)
LOG_LEVEL=info
