{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "lib": ["ES2022"],
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "outDir": "dist/server",
    "rootDir": "src/server",
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true
  },
  "include": ["src/server"],
  "exclude": ["node_modules", "dist"]
}
