{
  "name": "imap-toolkit",
  "version": "0.1.0",
  "type": "module",
  "private": true,
  "description": "IMAP mailbox watcher that permanently deletes emails matching your filters",
  "scripts": {
    "dev": "tsx watch src/server/index.ts",
    "dev:all": "concurrently -n api,ui -c cyan,magenta \"npm run dev\" \"npx vite src/client\"",
    "build:server": "tsc -p tsconfig.server.json",
    "build:client": "vite build",
    "build": "npm run build:server && npm run build:client",
    "start": "node dist/server/index.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:migrate": "tsx src/server/db/migrate.ts"
  },
  "dependencies": {
    "@fastify/cookie": "^9.3.1",
    "@fastify/cors": "^9.0.1",
    "@fastify/jwt": "^8.0.1",
    "@fastify/static": "^7.0.4",
    "@libsql/client": "^0.14.0",
    "dotenv": "^16.4.5",
    "fastify": "^4.26.2",
    "imapflow": "^1.0.162",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@types/node": "^20.11.17",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.2.1",
    "autoprefixer": "^10.4.17",
    "concurrently": "^10.0.7",
    "postcss": "^8.4.35",
    "tailwindcss": "^3.4.1",
    "tsx": "^4.7.1",
    "typescript": "^5.3.3",
    "vite": "^5.1.3",
    "vitest": "^1.3.1"
  }
}
